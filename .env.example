PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=
# Sandbox test card for the card payment route (PayPal sandbox test card; config only)
PAYPAL_CARD_NUMBER=
# MM/YYYY, MM/YY or YYYY-MM (normalised to YYYY-MM). Number, expiry and CVV are all required in real mode.
PAYPAL_CARD_EXPIRY=
PAYPAL_CARD_CVV=
PAYPAL_CARD_NAME=
BUYER_EMAIL=
BUYER_PASSWORD=
GROQ_API_KEY=
# Optional. Primary model for the Guardian's category check (default openai/gpt-oss-20b).
# A 404 / model-not-found logs one warning and tries GROQ_MODELS; /health shows what answered.
GROQ_MODEL=
# Ordered comma-separated fallbacks after GROQ_MODEL (default openai/gpt-oss-20b,openai/gpt-oss-120b)
GROQ_MODELS=
CHANNEL3_API_KEY=
DATABASE_URL=
# Key directories (generated on first run, never commit). Empty = ./keys
LEDGER_SIGNING_KEY_PATH=
MANDATE_SIGNING_KEY_PATH=
# Mock mode: /v1 returns fixtures from contract/fixtures/ (default on)
GAWAH_MOCK=1
# Service keys sent as the X-Gawah-Key header. Replace with your own random values locally.
SYSTEM1_KEY=
SYSTEM3_KEY=
# Optional. Requests per minute per service key (default 60, 0 disables). In memory, per process.
RATE_LIMIT_PER_MINUTE=
# Tests only. GAWAH_FAKE_PAYPAL=1 swaps in a SIMULATED PayPal and is refused unless GAWAH_ENV=test.
GAWAH_ENV=
GAWAH_FAKE_PAYPAL=
# Hosted demo only (docs/DEPLOY.md). GAWAH_ENV=demo + ADMIN_KEY enable POST /v1/admin/reset-demo.
# GAWAH_BOOTSTRAP=1 creates the schema, keys and demo merchant when the database is empty.
GAWAH_BOOTSTRAP=
ADMIN_KEY=
# Comma-separated browser origins for CORS (default http://localhost:3000)
ENGINE_CORS_ORIGINS=

# Shopper (System 1). Defaults shown; the shopper reads this file.
# demo = the built-in demo catalog; channel3 = real products (needs CHANNEL3_API_KEY).
PRODUCT_PROVIDER=demo
# false by default. true enables the shopper's SIMULATED attack-run endpoint.
ATTACK_SIMULATION_ENABLED=false
# Where the shopper keeps its demo merchant's cart-signing key (gitignored keys/ directory).
MERCHANT_SIGNING_KEY_PATH=keys/system1-merchant
# Engine ledger live feed (Server-Sent Events). Defaults shown.
# Seconds between keepalive comments.
SSE_KEEPALIVE_S=15
# Seconds between database polls for new ledger entries.
SSE_POLL_S=0.25
