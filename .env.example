PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=
# Sandbox test card for the card payment route (PayPal sandbox test card; config only)
PAYPAL_CARD_NUMBER=
PAYPAL_CARD_EXPIRY=
PAYPAL_CARD_CVV=
PAYPAL_CARD_NAME=
BUYER_EMAIL=
BUYER_PASSWORD=
GROQ_API_KEY=
# Optional. Model for the Guardian's category check (default llama-3.3-70b-versatile).
# Not every key can use every model: if the default 404s, try openai/gpt-oss-20b (see scripts/groq_check.py)
GROQ_MODEL=
CHANNEL3_API_KEY=
DATABASE_URL=
# Key directories (generated on first run, never commit). Empty = ./keys
LEDGER_SIGNING_KEY_PATH=
MANDATE_SIGNING_KEY_PATH=
NEXT_PUBLIC_ENGINE_URL=
# Mock mode: /v1 returns fixtures from contract/fixtures/ (default on)
GAWAH_MOCK=1
# Service keys sent as the X-Gawah-Key header. Replace with your own random values locally.
SYSTEM1_KEY=
SYSTEM3_KEY=
