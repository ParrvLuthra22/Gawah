{
  "$defs": {
    "VerificationCheck": {
      "additionalProperties": false,
      "description": "One named check inside a verification result (additive; see docs/CONTRACT.md).",
      "properties": {
        "detail": {
          "default": "",
          "description": "Human-readable outcome of this check",
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "description": "ledger_chain | mandate_signature | cart_signature | payment_reference_match",
          "title": "Name",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "ok"
      ],
      "title": "VerificationCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checked": {
      "title": "Checked",
      "type": "integer"
    },
    "checks": {
      "description": "Per-check breakdown (evidence bundles); empty for a plain ledger verify",
      "items": {
        "$ref": "#/$defs/VerificationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "first_broken_seq": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Broken Seq"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why verification failed; null when ok",
      "title": "Reason"
    }
  },
  "required": [
    "ok",
    "checked"
  ],
  "title": "LedgerVerifyResult",
  "type": "object"
}
