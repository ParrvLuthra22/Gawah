# Use credentials from your own PayPal Sandbox app. Keep this file's local copy private.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
DATABASE_URL=sqlite:///./counsel.db
# Optional PostgreSQL: DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
SYSTEM2_BASE_URL=http://127.0.0.1:8000
# Outgoing engine key. Match the engine's SYSTEM3_KEY.
# Leave blank to reuse the local console key below.
SYSTEM2_KEY=
# Incoming Counsel key. Match the Next.js server's SYSTEM3_KEY.
SYSTEM3_KEY=
ENABLE_SANDBOX_RESOLUTION=false
# Local Resolution Center accounts keyed by operator ID. Store only SHA-256 token digests.
N5_OPERATORS={}
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
