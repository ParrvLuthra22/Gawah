# Read by the Next.js server. Browser requests go through the same-origin API.
SYSTEM3_API_URL="http://127.0.0.1:8002"
# Same value as SYSTEM3_KEY in system3/.env.
SYSTEM3_KEY=
# --- AI Shopper (/shop): LOCAL DEMO ONLY, PayPal Sandbox only -------------------------------
# The dashboard has no login, so the shopping routes (which can start a Sandbox payment) run only
# on `npm run dev`, on localhost/127.0.0.1, same-origin, and only when this is "true".
ENABLE_SHOPPING_CHECKOUT=false
# Same value as SYSTEM1_KEY in the repo-root .env (the shopper's proposal-only scope).
SYSTEM1_KEY=
# (SYSTEM3_KEY above is also used, for mandates and the Guardian dry run.)
ENGINE_URL=http://127.0.0.1:8000
SHOPPER_URL=http://127.0.0.1:8001
